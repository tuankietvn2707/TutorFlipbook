rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes unless explicitly matched below
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Security Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    // --- Entity Validation Helpers ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid == request.auth.uid
        && isOptionalString(data, 'email', 320)
        && isOptionalString(data, 'displayName', 160)
        && isOptionalString(data, 'photoURL', 1024)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookMeta(data, userId, bookId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'category', 'color',
          'totalPages', 'audioCount', 'syncStatus',
          'bookCreatedAt', 'lastModified', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'category', 'color',
          'totalPages', 'coverImage', 'videoUrl', 'audioCount',
          'syncStatus', 'bookCreatedAt', 'lastModified', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.id == bookId
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 300
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 64
        && data.color is string
        && data.color.size() >= 1
        && data.color.size() <= 32
        && data.totalPages is int
        && data.totalPages >= 0
        && data.totalPages <= 5000
        && isOptionalString(data, 'coverImage', 650000)
        && isOptionalString(data, 'videoUrl', 2048)
        && data.audioCount is int
        && data.audioCount >= 0
        && data.audioCount <= 5000
        && data.syncStatus is string
        && data.syncStatus in ['synced', 'syncing']
        && data.bookCreatedAt is string
        && data.bookCreatedAt.size() <= 64
        && (data.lastModified is int || data.lastModified is float)
        && data.lastModified >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookPageChunk(data, userId, bookId) {
      return data.keys().hasAll([
          'ownerId', 'bookId', 'pageIndex', 'partIndex',
          'totalParts', 'chunk', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'bookId', 'pageIndex', 'partIndex',
          'totalParts', 'chunk', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.bookId is string
        && data.bookId.size() <= 128
        && data.bookId == bookId
        && data.pageIndex is int
        && data.pageIndex >= 0
        && data.pageIndex <= 5000
        && data.partIndex is int
        && data.partIndex >= 0
        && data.partIndex <= 100
        && data.totalParts is int
        && data.totalParts >= 1
        && data.totalParts <= 100
        && data.chunk is string
        && data.chunk.size() >= 1
        && data.chunk.size() <= 700000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookAudioMeta(data, userId, bookId, trackId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'bookId', 'name',
          'totalChunks', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'bookId', 'name', 'folder',
          'fileType', 'mimeType', 'size', 'totalChunks',
          'externalUrl', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.id == trackId
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.bookId is string
        && data.bookId.size() <= 128
        && data.bookId == bookId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 300
        && isOptionalString(data, 'folder', 200)
        && isOptionalString(data, 'fileType', 32)
        && isOptionalString(data, 'mimeType', 128)
        && (!('size' in data) || (data.size is int && data.size >= 0 && data.size <= 104857600))
        && data.totalChunks is int
        && data.totalChunks >= 0
        && data.totalChunks <= 300
        && isOptionalString(data, 'externalUrl', 2048)
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.sortOrder <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookAudioChunk(data, userId, bookId, trackId) {
      return data.keys().hasAll([
          'ownerId', 'bookId', 'trackId', 'chunkIndex',
          'data', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'bookId', 'trackId', 'chunkIndex',
          'data', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.bookId is string
        && data.bookId.size() <= 128
        && data.bookId == bookId
        && data.trackId is string
        && data.trackId.size() <= 128
        && data.trackId == trackId
        && data.chunkIndex is int
        && data.chunkIndex >= 0
        && data.chunkIndex <= 300
        && data.data is string
        && data.data.size() >= 1
        && data.data.size() <= 700000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function parentBookOwnedByUser(userId, bookId) {
      let bookPath = /databases/$(database)/documents/users/$(userId)/books/$(bookId);
      return exists(bookPath) && get(bookPath).data.ownerId == request.auth.uid;
    }

    function parentTrackOwnedByUser(userId, bookId, trackId) {
      let trackPath = /databases/$(database)/documents/users/$(userId)/books/$(bookId)/audioTracks/$(trackId);
      return exists(trackPath) && get(trackPath).data.ownerId == request.auth.uid;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      match /books/{bookId} {
        allow get: if isValidId(userId) && isValidId(bookId) && isVerifiedOwner(userId);
        allow list: if isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(bookId)
          && isVerifiedOwner(userId)
          && isValidBookMeta(incoming(), userId, bookId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(bookId)
          && isVerifiedOwner(userId)
          && isValidBookMeta(incoming(), userId, bookId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'color', 'totalPages', 'coverImage',
              'videoUrl', 'audioCount', 'syncStatus', 'lastModified', 'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly(['syncStatus', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(bookId) && isVerifiedOwner(userId);

        match /pages/{pageDocId} {
          allow get: if isValidId(userId) && isValidId(bookId) && isValidId(pageDocId) && isVerifiedOwner(userId);
          allow list: if isVerifiedOwner(userId)
            && existing().ownerId == request.auth.uid
            && existing().bookId == bookId;
          allow create: if isValidId(userId)
            && isValidId(bookId)
            && isValidId(pageDocId)
            && isVerifiedOwner(userId)
            && isValidBookPageChunk(incoming(), userId, bookId)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && parentBookOwnedByUser(userId, bookId);
          allow update: if isValidId(userId)
            && isValidId(bookId)
            && isValidId(pageDocId)
            && isVerifiedOwner(userId)
            && isValidBookPageChunk(incoming(), userId, bookId)
            && incoming().ownerId == existing().ownerId
            && incoming().bookId == existing().bookId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['pageIndex', 'partIndex', 'totalParts', 'chunk', 'updatedAt'])
            && parentBookOwnedByUser(userId, bookId);
          allow delete: if isValidId(userId)
            && isValidId(bookId)
            && isValidId(pageDocId)
            && isVerifiedOwner(userId)
            && parentBookOwnedByUser(userId, bookId);
        }

        match /audioTracks/{trackId} {
          allow get: if isValidId(userId) && isValidId(bookId) && isValidId(trackId) && isVerifiedOwner(userId);
          allow list: if isVerifiedOwner(userId)
            && existing().ownerId == request.auth.uid
            && existing().bookId == bookId;
          allow create: if isValidId(userId)
            && isValidId(bookId)
            && isValidId(trackId)
            && isVerifiedOwner(userId)
            && isValidBookAudioMeta(incoming(), userId, bookId, trackId)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && parentBookOwnedByUser(userId, bookId);
          allow update: if isValidId(userId)
            && isValidId(bookId)
            && isValidId(trackId)
            && isVerifiedOwner(userId)
            && isValidBookAudioMeta(incoming(), userId, bookId, trackId)
            && incoming().id == existing().id
            && incoming().ownerId == existing().ownerId
            && incoming().bookId == existing().bookId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'folder', 'fileType', 'mimeType', 'size',
                'totalChunks', 'externalUrl', 'sortOrder', 'updatedAt'
              ])
              || incoming().diff(existing()).affectedKeys().hasOnly(['sortOrder', 'updatedAt'])
            )
            && parentBookOwnedByUser(userId, bookId);
          allow delete: if isValidId(userId)
            && isValidId(bookId)
            && isValidId(trackId)
            && isVerifiedOwner(userId)
            && parentBookOwnedByUser(userId, bookId);

          match /chunks/{chunkId} {
            allow get: if isValidId(userId) && isValidId(bookId) && isValidId(trackId) && isValidId(chunkId) && isVerifiedOwner(userId);
            allow list: if isVerifiedOwner(userId)
              && existing().ownerId == request.auth.uid
              && existing().bookId == bookId
              && existing().trackId == trackId;
            allow create: if isValidId(userId)
              && isValidId(bookId)
              && isValidId(trackId)
              && isValidId(chunkId)
              && isVerifiedOwner(userId)
              && isValidBookAudioChunk(incoming(), userId, bookId, trackId)
              && incoming().createdAt == request.time
              && incoming().updatedAt == request.time
              && parentTrackOwnedByUser(userId, bookId, trackId);
            allow update: if isValidId(userId)
              && isValidId(bookId)
              && isValidId(trackId)
              && isValidId(chunkId)
              && isVerifiedOwner(userId)
              && isValidBookAudioChunk(incoming(), userId, bookId, trackId)
              && incoming().ownerId == existing().ownerId
              && incoming().bookId == existing().bookId
              && incoming().trackId == existing().trackId
              && incoming().createdAt == existing().createdAt
              && incoming().updatedAt == request.time
              && incoming().diff(existing()).affectedKeys().hasOnly(['chunkIndex', 'data', 'updatedAt'])
              && parentTrackOwnedByUser(userId, bookId, trackId);
            allow delete: if isValidId(userId)
              && isValidId(bookId)
              && isValidId(trackId)
              && isValidId(chunkId)
              && isVerifiedOwner(userId)
              && parentTrackOwnedByUser(userId, bookId, trackId);
          }
        }
      }
    }
  }
}
