{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 320 },
        "displayName": { "type": "string", "maxLength": 160 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    },
    "EmailLibrary": {
      "title": "EmailLibrary",
      "description": "Shared cloud library workspace keyed by verified lowercase email so Google and Email/Password logins share one library.",
      "type": "object",
      "properties": {
        "libraryId": { "type": "string", "minLength": 3, "maxLength": 320 },
        "ownerEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 320 },
        "lastUpdatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["libraryId", "ownerEmail", "lastUpdatedByUid", "createdAt", "updatedAt"]
    },
    "BookMeta": {
      "title": "BookMeta",
      "description": "Book metadata, cover thumbnail, and sync summary.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerEmail": { "type": "string", "format": "email", "maxLength": 320 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "color": { "type": "string", "minLength": 1, "maxLength": 32 },
        "totalPages": { "type": "integer" },
        "coverImage": { "type": "string", "maxLength": 650000 },
        "videoUrl": { "type": "string", "maxLength": 2048 },
        "audioCount": { "type": "integer" },
        "syncStatus": { "type": "string", "enum": ["synced", "syncing"] },
        "bookCreatedAt": { "type": "string", "maxLength": 64 },
        "lastModified": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "category",
        "color",
        "totalPages",
        "audioCount",
        "syncStatus",
        "bookCreatedAt",
        "lastModified",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookPageChunk": {
      "title": "BookPageChunk",
      "description": "Size-bounded chunk of a rendered book page image.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerEmail": { "type": "string", "format": "email", "maxLength": 320 },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pageIndex": { "type": "integer" },
        "partIndex": { "type": "integer" },
        "totalParts": { "type": "integer" },
        "chunk": { "type": "string", "minLength": 1, "maxLength": 700000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "bookId", "pageIndex", "partIndex", "totalParts", "chunk", "createdAt", "updatedAt"]
    },
    "BookAudioMeta": {
      "title": "BookAudioMeta",
      "description": "Metadata for an audio track attached to a book.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerEmail": { "type": "string", "format": "email", "maxLength": 320 },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "folder": { "type": "string", "maxLength": 200 },
        "fileType": { "type": "string", "maxLength": 32 },
        "mimeType": { "type": "string", "maxLength": 128 },
        "size": { "type": "integer" },
        "totalChunks": { "type": "integer" },
        "externalUrl": { "type": "string", "maxLength": 2048 },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "bookId", "name", "totalChunks", "sortOrder", "createdAt", "updatedAt"]
    },
    "BookAudioChunk": {
      "title": "BookAudioChunk",
      "description": "Size-bounded audio payload chunk.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerEmail": { "type": "string", "format": "email", "maxLength": 320 },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "trackId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chunkIndex": { "type": "integer" },
        "data": { "type": "string", "minLength": 1, "maxLength": 700000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "bookId", "trackId", "chunkIndex", "data", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile isolated to its verified UID."
    },
    "/users/{userId}/books/{bookId}": {
      "schema": { "$ref": "#/entities/BookMeta" },
      "description": "Legacy UID-scoped books (migrated automatically to email library)."
    },
    "/users/{userId}/books/{bookId}/pages/{pageDocId}": {
      "schema": { "$ref": "#/entities/BookPageChunk" },
      "description": "Legacy UID-scoped book page chunks."
    },
    "/users/{userId}/books/{bookId}/audioTracks/{trackId}": {
      "schema": { "$ref": "#/entities/BookAudioMeta" },
      "description": "Legacy UID-scoped audio track metadata."
    },
    "/users/{userId}/books/{bookId}/audioTracks/{trackId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/BookAudioChunk" },
      "description": "Legacy UID-scoped audio payload chunks."
    },
    "/libraries/{libraryId}": {
      "schema": { "$ref": "#/entities/EmailLibrary" },
      "description": "Unified library workspace keyed by verified lowercase email."
    },
    "/libraries/{libraryId}/books/{bookId}": {
      "schema": { "$ref": "#/entities/BookMeta" },
      "description": "Books synced across both Google and Email/Password logins sharing the same verified email."
    },
    "/libraries/{libraryId}/books/{bookId}/pages/{pageDocId}": {
      "schema": { "$ref": "#/entities/BookPageChunk" },
      "description": "Rendered book page image chunks scoped to parent book."
    },
    "/libraries/{libraryId}/books/{bookId}/audioTracks/{trackId}": {
      "schema": { "$ref": "#/entities/BookAudioMeta" },
      "description": "Audio track metadata attached to a book."
    },
    "/libraries/{libraryId}/books/{bookId}/audioTracks/{trackId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/BookAudioChunk" },
      "description": "Chunked WAV/MP3 audio payloads."
    }
  }
}
